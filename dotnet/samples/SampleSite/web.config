<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Waniwani:AgentTrafficKey" value="wwt_e2e.b3JnLWtleQ" />
    <add key="Waniwani:BaseUrl" value="http://127.0.0.1:4600" />
    <add key="Waniwani:ClientIpHeader" value="X-Forwarded-For" />
    <add key="Waniwani:TrustedProxies" value="127.0.0.2" />
    <add key="Waniwani:Enabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.6.2" />
    <httpRuntime targetFramework="4.6.2" maxRequestLength="4096" />
    <caching>
      <outputCache enableOutputCache="true" enableKernelCacheForVaryByStar="true" />
    </caching>
  </system.web>
  <system.webServer>
    <modules>
      <add name="WaniwaniRelay" type="Waniwani.Relay.AspNet.WaniwaniRelayModule, Waniwani.Relay.AspNet" />
    </modules>
    <handlers>
      <clear />
      <add name="StaticText" path="*.txt" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
      <add name="SamplePages" path="*" verb="*" type="SampleSite.SamplePages, SampleSite" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
    </handlers>
    <caching enabled="true" enableKernelCache="true" />
  </system.webServer>
</configuration>
